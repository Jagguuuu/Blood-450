# Copy this file to .env and fill in your values.
# Do not commit .env to git.

DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
# DJANGO_ENV=production

# --- PostgreSQL (optional; if not set, SQLite is used) ---
# Option A: Single URL (e.g. from Vercel Postgres / Supabase)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Option B: Individual vars (use your real host, database name, user, password)
# POSTGRES_HOST=your-db-host.example.com
# POSTGRES_NAME=your_database_name
# POSTGRES_USER=your_username
# POSTGRES_PASSWORD=your_password
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# --- OTP SMS (for registration; send OTP to mobile) ---
# Option 1: Fast2SMS (India) – get API key at https://www.fast2sms.com/
# OTP_SMS_BACKEND=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_dev_api_key

# Option 2: Twilio Verify (no from number; use Verify Service SID)
# OTP_SMS_BACKEND=twilio_verify
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# --- Google Sign-In (donor registration) – create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials ---
# GOOGLE_OAUTH_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# Optional: Android / iOS client IDs accepted as ID-token audience for Flutter
# GOOGLE_OAUTH_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
# GOOGLE_OAUTH_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
# Add authorized redirect URI: https://yourdomain.com/register/google/callback/ (and http://localhost:8000/register/google/callback/ for local)
# Flutter must pass the WEB client ID as: --dart-define=GOOGLE_SERVER_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
# Never put GOOGLE_OAUTH_CLIENT_SECRET in Flutter.

# --- Email (password reset) ---
# Local dev: omit EMAIL_BACKEND to use console backend (reset links printed in Django logs).
# Production (example SMTP):
# APP_BASE_URL=https://your-app.vercel.app
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=Blood450 <noreply@yourdomain.com>

# --- WhatsApp Cloud API (live chat + blood alerts) ---
# WHATSAPP_PROVIDER=console
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=blood450_verify_token
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v20.0
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_TASK_ALWAYS_EAGER=false
